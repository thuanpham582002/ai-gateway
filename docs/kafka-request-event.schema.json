{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigateway.envoyproxy.io/schemas/kafka-request-event-v1.json",
  "title": "Envoy AI Gateway Kafka Request Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "event_type",
    "timestamp",
    "request_id",
    "operation",
    "protocol",
    "transport",
    "original_model",
    "request_model",
    "response_model",
    "backend",
    "success",
    "latency_ms",
    "stream",
    "capture_policy"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "event_type": {"enum": ["request_completed", "request_failed"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "request_id": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "protocol": {"type": "string", "minLength": 1},
    "transport": {"enum": ["http", "http_sse"]},
    "client": {"$ref": "#/$defs/client"},
    "conversation_key": {"type": "string", "maxLength": 4096},
    "correlation": {"$ref": "#/$defs/correlation"},
    "original_model": {"type": "string"},
    "request_model": {"type": "string"},
    "response_model": {"type": "string"},
    "backend": {"type": "string"},
    "backend_name": {"type": "string"},
    "success": {"type": "boolean"},
    "error_type": {"type": "string"},
    "latency_ms": {"type": "number", "minimum": 0},
    "tokens": {"$ref": "#/$defs/tokens"},
    "stream": {"type": "boolean"},
    "time_to_first_token_ms": {"type": "number", "minimum": 0},
    "inter_token_latency_ms": {"type": "number", "minimum": 0},
    "billing": {"$ref": "#/$defs/billing"},
    "capture_policy": {"$ref": "#/$defs/capture_policy"},
    "headers": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "selected_pool": {"type": "string"},
    "model_name_override": {"type": "string"},
    "request_audit": {"$ref": "#/$defs/request_audit"},
    "parse_failure": {"$ref": "#/$defs/parse_failure"},
    "request_body": {"$ref": "#/$defs/body_snapshot"},
    "upstream_request_body": {"$ref": "#/$defs/body_snapshot"},
    "response_body": {"$ref": "#/$defs/body_snapshot"}
  },
  "$defs": {
    "parse_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "message", "tool_types_truncated"],
      "properties": {
        "stage": {"const": "request_body_parse"},
        "message": {"type": "string", "maxLength": 1024},
        "tool_types": {
          "type": "array",
          "maxItems": 64,
          "items": {"type": "string", "maxLength": 128}
        },
        "tool_types_truncated": {"type": "boolean"}
      }
    },
    "request_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truncated"],
      "properties": {
        "body": {"type": "object"},
        "tool_calls": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/tool_call_audit"}
        },
        "truncated": {"type": "boolean"}
      }
    },
    "tool_call_audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "arguments": {"type": "string", "maxLength": 65536}
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1}
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {"$ref": "#/$defs/native_identifier"},
        "conversation_id": {"$ref": "#/$defs/native_identifier"},
        "branch_id": {"$ref": "#/$defs/native_identifier"},
        "thread_id": {"$ref": "#/$defs/native_identifier"},
        "parent_thread_id": {"$ref": "#/$defs/native_identifier"},
        "turn_id": {"$ref": "#/$defs/native_identifier"},
        "window_id": {"$ref": "#/$defs/native_identifier"},
        "parent_turn_id": {"$ref": "#/$defs/native_identifier"},
        "previous_response_id": {"$ref": "#/$defs/native_identifier"},
        "response_id": {"$ref": "#/$defs/native_identifier"},
        "provider_response_id": {"$ref": "#/$defs/native_identifier"},
        "forked_from_thread_id": {"$ref": "#/$defs/native_identifier"},
        "agent_id": {"$ref": "#/$defs/native_identifier"},
        "parent_agent_id": {"$ref": "#/$defs/native_identifier"}
      }
    },
    "native_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "cache_creation_input_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_key_id": {"type": "string"},
        "billing_request_id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "subject_id": {"type": "string"},
        "subject_type": {"type": "string"},
        "project_id": {"type": "string"},
        "input_price": {"type": "string"},
        "output_price": {"type": "string"},
        "reserved_cost": {"type": "string"},
        "credit_remaining": {"type": "string"},
        "rate_limit_remaining": {"type": "string"},
        "is_free": {"type": "boolean"},
        "admission_reserved": {"type": "boolean"},
        "reserved_input_tokens": {"type": "integer", "minimum": 0},
        "reserved_output_tokens": {"type": "integer", "minimum": 0},
        "project_in_flight_slot": {"type": "integer", "minimum": 0},
        "api_key_in_flight_slot": {"type": "integer", "minimum": 0},
        "model_concurrency_slot": {"type": "integer", "minimum": 0}
      }
    },
    "capture_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "max_inline_bytes"],
      "properties": {
        "mode": {"enum": ["hash_only", "bounded_inline"]},
        "max_inline_bytes": {"type": "integer", "minimum": 0},
        "external_body_store": {"$ref": "#/$defs/external_store_policy"}
      }
    },
    "external_store_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "max_body_bytes"],
      "properties": {
        "provider": {"const": "s3"},
        "max_body_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "body_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size_bytes", "truncated"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "same_as": {"enum": ["request_body"]},
        "encoding": {"enum": ["utf-8", "base64"]},
        "content": {"type": "string"},
        "truncated": {"type": "boolean"},
        "object": {"$ref": "#/$defs/body_object_reference"},
        "external_storage_error": {"enum": ["upload_pending", "upload_failed", "body_exceeds_external_limit"]}
      }
    },
    "body_object_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "bucket", "key"],
      "properties": {
        "provider": {"const": "s3"},
        "bucket": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "etag": {"type": "string"},
        "version_id": {"type": "string"}
      }
    }
  }
}
